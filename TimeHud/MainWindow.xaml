<Window x:Class="TimeHud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeHud"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="OnRootMouseLeftButtonDown"
        PreviewMouseWheel="OnRootMouseWheel">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Font">
                <MenuItem x:Name="FontCascadiaMono" Header="Cascadia Mono" IsCheckable="True" Click="OnFontPresetClick" Tag="cascadiamono"/>
                <MenuItem x:Name="FontCascadia"     Header="Cascadia Code" IsCheckable="True" Click="OnFontPresetClick" Tag="cascadia"/>
                <MenuItem x:Name="FontConsolas"     Header="Consolas"      IsCheckable="True" Click="OnFontPresetClick" Tag="consolas"/>
                <Separator/>
                <MenuItem x:Name="FontDseg7"        Header="DSEG7 Classic Mini" IsCheckable="True" Click="OnFontPresetClick" Tag="dseg7"/>
                <MenuItem x:Name="FontD7Mono"       Header="Digital-7 Mono"     IsCheckable="True" Click="OnFontPresetClick" Tag="d7mono"/>
            </MenuItem>
            <MenuItem Header="Color">
                <MenuItem x:Name="ColorGreen" Header="Phosphor Green" IsCheckable="True" Click="OnColorPresetClick" Tag="green"/>
                <MenuItem x:Name="ColorAmber" Header="Amber"          IsCheckable="True" Click="OnColorPresetClick" Tag="amber"/>
                <MenuItem x:Name="ColorCyan"  Header="Cyan"           IsCheckable="True" Click="OnColorPresetClick" Tag="cyan"/>
                <MenuItem x:Name="ColorWhite" Header="White"          IsCheckable="True" Click="OnColorPresetClick" Tag="white"/>
                <MenuItem x:Name="ColorRed"   Header="Red"            IsCheckable="True" Click="OnColorPresetClick" Tag="red"/>
                <Separator/>
                <MenuItem Header="Custom..." Click="OnColorCustomClick"/>
            </MenuItem>
            <MenuItem x:Name="SizeMenu" Header="Size">
                <MenuItem Header="20 pt" IsCheckable="True" Click="OnSizePresetClick" Tag="20"/>
                <MenuItem Header="24 pt" IsCheckable="True" Click="OnSizePresetClick" Tag="24"/>
                <MenuItem Header="28 pt" IsCheckable="True" Click="OnSizePresetClick" Tag="28"/>
                <MenuItem Header="32 pt" IsCheckable="True" Click="OnSizePresetClick" Tag="32"/>
                <MenuItem Header="40 pt" IsCheckable="True" Click="OnSizePresetClick" Tag="40"/>
                <MenuItem Header="48 pt" IsCheckable="True" Click="OnSizePresetClick" Tag="48"/>
                <MenuItem Header="64 pt" IsCheckable="True" Click="OnSizePresetClick" Tag="64"/>
                <MenuItem Header="96 pt" IsCheckable="True" Click="OnSizePresetClick" Tag="96"/>
                <Separator/>
                <MenuItem Header="Ctrl+Wheel adjusts" IsEnabled="False"/>
            </MenuItem>
            <MenuItem x:Name="TextAlphaMenu" Header="Text alpha">
                <MenuItem Header="100%" IsCheckable="True" Click="OnTextAlphaPresetClick" Tag="1.00"/>
                <MenuItem Header="90%"  IsCheckable="True" Click="OnTextAlphaPresetClick" Tag="0.90"/>
                <MenuItem Header="75%"  IsCheckable="True" Click="OnTextAlphaPresetClick" Tag="0.75"/>
                <MenuItem Header="60%"  IsCheckable="True" Click="OnTextAlphaPresetClick" Tag="0.60"/>
                <MenuItem Header="45%"  IsCheckable="True" Click="OnTextAlphaPresetClick" Tag="0.45"/>
                <MenuItem Header="30%"  IsCheckable="True" Click="OnTextAlphaPresetClick" Tag="0.30"/>
                <Separator/>
                <MenuItem Header="Shift+Wheel adjusts" IsEnabled="False"/>
            </MenuItem>
            <MenuItem x:Name="TimerMenu" Header="Timer">
                <MenuItem x:Name="ShowTimerMenu" Header="Show timer" IsCheckable="True" Click="OnShowTimerClick"/>
                <Separator/>
                <MenuItem Header="5 min"  IsCheckable="True" Click="OnTimerPresetClick" Tag="5"/>
                <MenuItem Header="10 min" IsCheckable="True" Click="OnTimerPresetClick" Tag="10"/>
                <MenuItem Header="15 min" IsCheckable="True" Click="OnTimerPresetClick" Tag="15"/>
                <MenuItem Header="30 min" IsCheckable="True" Click="OnTimerPresetClick" Tag="30"/>
                <MenuItem Header="45 min" IsCheckable="True" Click="OnTimerPresetClick" Tag="45"/>
                <MenuItem Header="60 min" IsCheckable="True" Click="OnTimerPresetClick" Tag="60"/>
            </MenuItem>
            <MenuItem x:Name="AutostartMenu" Header="Start with Windows" IsCheckable="True" Click="OnAutostartClick"/>
            <MenuItem Header="Reset position" Click="OnResetPositionClick"/>
            <Separator/>
            <MenuItem Header="Exit" Click="OnExitClick"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Grid>
        <Border x:Name="Backdrop" CornerRadius="6" Background="#202020"/>
        <!-- Row carries font family/size/color as TextElement attached properties (inherited by both
             TextBlocks) and text alpha as Row.Opacity. Divider and icon brushes are set from code. -->
        <StackPanel x:Name="Row" Orientation="Horizontal" Margin="10,5"
                    TextElement.Foreground="#00FF5A" TextElement.FontSize="48">
            <TextBlock x:Name="ClockText" VerticalAlignment="Center" Text="0000.00.00 (XXX) 00:00:00"/>
            <StackPanel x:Name="TimerGroup" Orientation="Horizontal">
                <Rectangle x:Name="Divider" Width="1" Margin="12,4" Opacity="0.5" Fill="#00FF5A"/>
                <TextBlock x:Name="TimerText" VerticalAlignment="Center" Text="30:00"/>
                <Button x:Name="TimerButton" Click="OnTimerButtonClick" Margin="8,0,0,0"
                        Focusable="False" Cursor="Hand" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="2">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Viewbox x:Name="TimerIconBox" Stretch="Uniform" Width="38" Height="38">
                        <Canvas Width="24" Height="24">
                            <!-- Lucide icon (play / rotate-ccw), swapped from code-behind. -->
                            <Path x:Name="TimerIcon"
                                  Stroke="#00FF5A"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M6 3 L20 12 L6 21 Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
